{
  "name": "ivy",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "ivy": "IVY_HOME=.ivy bun packages/cli/src/main.ts",
