{
  "name": "ivy",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "plugins/*",
    "evals"
  ],
  "scripts": {
    "ivy": "bun packages/cli/src/main.ts",
    "build": "bun scripts/build.ts",
    "build:app": "bun scripts/build-app.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p packages/web",
    "lint": "biome check . && bun scripts/check-design-links.ts",
    "format": "biome format --write .",
    "eval": "bun evals/run.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  },
  "patchedDependencies": {
    "marked-terminal@7.3.0": "patches/marked-terminal@7.3.0.patch"
  }
}
